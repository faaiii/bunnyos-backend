# BunnyOS Production Environment Variables Configuration Template
# Rename this file to .env or load into your production container environment

# Database Connection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=bunnyos_db;Username=bunnyos_admin;Password=Your_Secure_Password_Here;

# Authentication & Security
Jwt__Key=Your_Strong_Super_Secret_Key_At_Least_256_Bits_Long_BunnyOS_2026!
Jwt__Issuer=https://api.bunnyos.app
Jwt__Audience=https://bunnyos.app
Jwt__ExpirationMinutes=1440

# AI Engine Integration (Google Gemini or LLM API)
Gemini__ApiKey=YOUR_API_KEY_HERE
Gemini__Model=gemini-2.5-flash

# Logging
Serilog__MinimumLevel=Information
ASPNETCORE_ENVIRONMENT=Production
